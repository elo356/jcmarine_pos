rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function canReadEmployeeData() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if canReadEmployeeData();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() &&
        (
          isAdmin() ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cashier'
        );
    }

    match /inventoryLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /onlineOrders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /onlineStoreSettings/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Las notas eliminadas se conservan con deletedAt/expiresAt para permitir
    // restaurarlas durante 10 dias desde la papelera.
    match /notes/{noteId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /posCarts/{cartId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /systemSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Scanner virtual: la computadora (host) crea la sesion con un codigo de 6
    // digitos, el celular la reclama mientras esta en 'waiting' y solo el celular
    // vinculado puede enviar lecturas. Solo el host las lee y las borra.
    function scannerSession(code) {
      return get(/databases/$(database)/documents/scannerSessions/$(code)).data;
    }

    match /scannerSessions/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn() &&
        request.resource.data.hostUid == resource.data.hostUid &&
        (
          resource.data.hostUid == request.auth.uid ||
          (resource.data.status == 'waiting' && request.resource.data.pairedUid == request.auth.uid) ||
          resource.data.pairedUid == request.auth.uid
        );
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      match /scans/{scanId} {
        allow read, delete: if isSignedIn() && scannerSession(code).hostUid == request.auth.uid;
        allow create: if isSignedIn() &&
          scannerSession(code).status == 'paired' &&
          scannerSession(code).pairedUid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid;
      }
    }

    match /_meta/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
